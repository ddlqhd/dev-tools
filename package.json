{
  "name": "dev-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "codeloop": "pnpm --filter @devtools/cli exec node ./dist/index.js",
    "platform:server": "pnpm --filter @devtools/platform-server start",
    "platform:web": "pnpm --filter @devtools/platform-web dev",
    "platform:build": "pnpm --filter @devtools/platform-web build && pnpm --filter @devtools/platform-server build",
    "e2e:platform": "node tmp/e2e/run.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
