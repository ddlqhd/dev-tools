{
  "name": "dev-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "codeloop": "pnpm --filter @devtools/cli exec node ./dist/index.js",
    "platform:server": "node packages/platform-server/dist/cli.js",
    "platform:web": "pnpm --filter @devtools/platform-web dev",
    "platform:build": "pnpm --filter @devtools/platform-web build && pnpm --filter @devtools/platform-server build",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "engines": {
    "node": ">=22.13"
  }
}
