{
  "name": "@devtools/platform-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codeloop-platform": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-assets.mjs platform-server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test 'dist-test/test/*.test.js'",
    "start": "node ./dist/cli.js",
    "dev": "node --watch ./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@devtools/kernel": "workspace:*",
    "@devtools/shared": "workspace:*",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "ws": "^8.18.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2"
  }
}
