{
  "name": "@devtools/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "codeloop": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test 'dist-test/test/*.test.js'",
    "codeloop": "node ./dist/index.js"
  },
  "dependencies": {
    "@devtools/kernel": "workspace:*",
    "@devtools/shared": "workspace:*",
    "commander": "^13.1.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2"
  }
}
